{
  "name": "pet-health",
  "version": "1.0.0",
  "private": true,
  "description": "宠物健康管家系统 - Monorepo",
  "scripts": {
    "web": "pnpm --filter @pet-health/web",
    "miniapp": "pnpm --filter @pet-health/miniapp",
    "server": "pnpm --filter @pet-health/server",
    "shared": "pnpm --filter @pet-health/shared",
    "dev:web": "pnpm --filter @pet-health/web dev",
    "dev:server": "pnpm --filter @pet-health/server start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
